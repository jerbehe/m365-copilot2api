# HTTP bind address (default: 127.0.0.1:4141)
M365_LISTEN=127.0.0.1:4141

# OAuth/account cache. Keep this file private and mode 0600.
M365_CONFIG=$HOME/.config/m365-copilot2api/accounts.json

# Required administrator password for the web console and management APIs.
# Never commit a real value.
M365_ADMIN_PASSWORD=admin123

# Maximum number of simultaneous upstream calls per account.
M365_ACCOUNT_DEFAULT_CONCURRENCY=8

# Implicit reuse of existing M365 cloud conversations. Enabled by default: a hit
# means the cloud conversation already holds the history, so only the increment
# is sent (3-5s -> ~1s). Set to 0 when diagnosing answers that carry context
# from an unrelated conversation — every request then creates a fresh cloud
# conversation, which is deleted right after the response. Explicit continuation
# (session_key field, X-M365-Session-Id header) is unaffected either way.
# Cloud conversation reuse is matched in this order, first hit wins:
#   1. X-M365-Session-Id header      (this gateway's own contract)
#   2. session-id header             (reported by Codex)
#   3. thread-id header              (reported by Codex)
#   4. X-Claude-Code-Session-Id      (reported by Claude Code)
#   5. prompt fingerprint            (first N chars of the first user message)
#   6. content key                   (strict message prefix + client fingerprint)
# Layers 1-4 are keyed by the reported id and isolated per API-key tenant.
# Layer 5 deliberately tolerates a diverged history so repeated prompts land on
# the same M365 conversation; it is still scoped by tenant AND client
# fingerprint, otherwise anyone sharing an API key could join another user's
# conversation by opening with the same sentence. Set to 0 to disable layer 5.
# M365_PROMPT_PREFIX_CHARS=200

# M365_CONV_REUSE=0

# Explicit session_key -> cloud conversation mapping. Must NOT share a file with
# M365_SESSION_CACHE (the content-key resolver): the two formats are incompatible
# and would silently overwrite each other. Defaults to $M365_DATA_DIR when set.
# M365_SESSION_KEY_CACHE=/data/session-keys.json
# M365_USER_SESSION_CACHE=/data/user-sessions.json

# Optional public identity policy. Disabled by default; set true only for the
# Microsoft gateway channel that needs neutralized public identity output.
M365_PUBLIC_IDENTITY_POLICY=false

# Browser PKCE OAuth. The nativeclient redirect remains the safe default.
# Loopback is explicit opt-in and must exactly match a redirect URI registered
# for your own Azure application client ID.
# M365_BROWSER_CLIENT_ID=your-registered-application-client-id
# M365_BROWSER_AUTHORITY=https://login.microsoftonline.com/common
# M365_BROWSER_SCOPE=openid profile offline_access
# M365_BROWSER_REDIRECT_URI=http://127.0.0.1:4141/api/auth/callback

# Device Code OAuth is configured independently from browser PKCE.
# M365_DEVICE_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
# M365_DEVICE_AUTHORITY=https://login.microsoftonline.com/common
# M365_DEVICE_SCOPE=openid profile offline_access

# Legacy M365_CLIENT_ID, M365_AUTHORITY, M365_SCOPE, and M365_REDIRECT_URI
# remain supported as fallbacks when the flow-specific variables are unset.
